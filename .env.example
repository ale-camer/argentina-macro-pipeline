# ==============================================================================
# EXECUTION & INGESTION CONFIGURATION
# ==============================================================================
# When "true", downloads fresh raw files live from World Bank, Ministry of Economy, SIPA, and INDEC.
# When "false", uses the verified local cache in data/raw_cache/.
PREFER_NETWORK=false

# ==============================================================================
# GCP MEDALLION DATA LAKE (GCS + BigQuery in us-central1 Always Free Tier)
# ==============================================================================
GCP_LAKE_SYNC=false
GCP_PROJECT_ID=argentina-macro-pipeline
GCS_LAKE_BUCKET=gs://argentina-macro-lake-31037835126
BQ_DATASET=macro_lake

# ==============================================================================
# ENCAPSULATED AGENT LAYER (Google GenAI / Gemini)
# ==============================================================================
# Optional: Only invoked if a deterministic parser fails (Agent 1: SelfHealingIngestionAgent)
# or for multimodal visual QA of the 5 figures and PR drafting (Agent 2: VisualQAAndRegimeAgent).
# When unset, the pipeline operates 100% via deterministic fallbacks.
GEMINI_API_KEY=

# ==============================================================================
# ALWAYS-ON MONITORING & ALERTS (WhatsApp via TextMeBot / CallMeBot API)
# ==============================================================================
# WHATSAPP_PHONE: WhatsApp Group JID (e.g., 120363...@g.us) or phone number (+4177...)
# WHATSAPP_APIKEY: TextMeBot alphanumeric API key or CallMeBot numeric API key
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# ==============================================================================
# ALWAYS-ON MONITORING & ALERTS (Telegram Bot API)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# ALWAYS-ON MONITORING & ALERTS (Email via SMTP)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
